<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_yakka_tiled"
    android:paddingHorizontal="24dp"
    android:paddingVertical="16dp"
    tools:context=".buyer.RegistrationSuccessFragment">

    <!-- Green Checkmark Circle -->
    <ImageView
        android:id="@+id/iv_success_check"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:contentDescription="@string/registration_successful"
        android:src="@drawable/ic_check_circle"
        app:tint="#0E3818"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.32" />

    <!-- Success Message Title -->
    <TextView
        android:id="@+id/tv_success_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/registration_successful"
        android:textColor="#0E3818"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_success_check"
        android:layout_marginTop="24dp" />

    <!-- Action Button: Login to Your Account -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_login_account"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:backgroundTint="#0E3818"
        android:text="@string/btn_login_to_your_account"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="28dp"
        app:icon="@drawable/ic_store"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconTint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.75" />

</androidx.constraintlayout.widget.ConstraintLayout>