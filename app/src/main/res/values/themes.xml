<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.CraftLanka" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorPrimaryVariant">@color/brand_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/nav_active_bg</item>
        <item name="colorSecondaryVariant">@color/nav_active_content</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Bottom Navigation Customization -->
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>
    </style>

    <style name="Widget.App.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="enableEdgeToEdge">true</item>
    </style>

    <!-- Missing Styles Required by Restored Layouts -->
    <style name="RoundedCorners">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="RoundedSquare">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ActiveIndicatorPill" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_active_bg</item>
        <item name="android:width">44dp</item>
        <item name="android:height">32dp</item>
    </style>

    <style name="ShapeAppearance.App.Corner24dp" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">24dp</item>
    </style>
</resources>